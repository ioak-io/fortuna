*.tgz

help.md

# Python virtual environments
/python/.venv
/python/venv

# Python/Poetry artifacts (workspace under python/)
# Byte-compiled / cache
/python/**/__pycache__/
/python/**/*.py[cod]
/python/**/*.pyo
/python/.pytest_cache/
/python/**/.pytest_cache/
/python/.mypy_cache/
/python/**/.mypy_cache/
/python/.ruff_cache/
/python/**/.ruff_cache/

# Virtual environments inside packages/services
/python/**/.venv/
/python/**/venv/

# Coverage and test reports
/python/.coverage
/python/.coverage.*
/python/coverage.xml
/python/htmlcov/

# Type checker and tooling caches
/python/.pytype/
/python/.dmypy.json
/python/dmypy.json

# Jupyter and misc
/python/.ipynb_checkpoints
/python/**/.ipynb_checkpoints/
/python/.python-version

# TypeScript build info
**/.tsbuildinfo/
*.tsbuildinfo

# Poetry build output is already covered by **/dist/ above
