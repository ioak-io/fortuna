{
  "name": "fortuna-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r --stream build",
    "dev:migration": "dotenv -e .env.migration.dev -- pnpm --filter migration-service dev",
    "dev:content": "dotenv -e .env.content.dev -- pnpm --filter content-service dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r --parallel exec rm -rf dist && rm -rf dist && find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' + && find . -name \"*.tsbuildinfo\" -type f -delete"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.5",
    "@types/node": "^20.11.24",
    "@types/semver": "^7.5.8",
    "concurrently": "^7.0.0",
    "dotenv-cli": "^10.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}